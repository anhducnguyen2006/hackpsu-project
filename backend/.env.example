GEMINI_API_KEY=
# Must be a model ID accepted by the live Gemini API for this project key.
# Google currently directs new users to gemini-3.8-flash; invalid IDs cause
# interpretation/suitability fallback or unavailable assessment.
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3 interpretation thinking level: MINIMAL, LOW, MEDIUM, or HIGH.
GEMINI_INTERPRET_THINKING_LEVEL=low
GEMINI_REQUEST_TIMEOUT_MS=15000
GEMINI_RETRY_ATTEMPTS=1
# Leave empty until a bounded suitability benchmark validates a fallback model.
GEMINI_FALLBACK_MODEL=
GEMINI_OVERALL_TIMEOUT_MS=16000
GEMINI_FALLBACK_RESERVE_MS=6000
GEMINI_PROVIDER_MIN_TIMEOUT_MS=10000
UCI_DATA_CACHE_TTL_SECONDS=900
BACKEND_CORS_ORIGINS=http://localhost:5173
# External scientific repository discovery sources.
DATAVERSE_ENABLED=true
DATAVERSE_API_URL=https://dataverse.harvard.edu/api/search
DATAVERSE_RESULTS_LIMIT=5
# Exact object-store hostname(s) accepted only as redirects from the Dataverse
# file-access API. Never an initial download host. No wildcards.
DATAVERSE_STORAGE_HOSTS=dvn-cloud-iqss.s3.amazonaws.com
ZENODO_ENABLED=true
ZENODO_API_URL=https://zenodo.org/api/records/
ZENODO_RESULTS_LIMIT=5
DISCOVERY_SOURCE_CONCURRENCY=3
DISCOVERY_CANDIDATE_LIMIT=12
DISCOVERY_METADATA_CONCURRENCY=4
# Declared file size above this is not an eligible analysis resource.
DISCOVERY_MAX_RESOURCE_BYTES=52428800
# Cosine scores below this are omitted instead of filling the result limit.
DISCOVERY_RELEVANCE_FLOOR=0.20
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=1
EMBEDDING_TOP_K=12
# Set true only for the cached, clearly labeled hackathon demo workflow.
DEMO_MODE=false

# Auth0 API access tokens. Leave these blank until the Dashboard API exists.
# AUTH0_DOMAIN is the tenant host with no scheme. The current SPA uses
# dev-cavt8qsoguvw8bjv.us.auth0.com. AUTH0_AUDIENCE is the API identifier,
# not the SPA client ID. Do not put a client secret in this file.
# Verification uses the tenant JWKS. RS256 is required.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Optional. Defaults to https://AUTH0_DOMAIN/
# AUTH0_ISSUER=
AUTH0_JWKS_CACHE_SECONDS=600
# Optional permission. Empty means a valid access token is enough.
# AUTH0_REQUIRED_SCOPE=
# Development dataset fetch stays off unless this is true. It still requires a token.
DEV_ROUTES_ENABLED=false
# Process-local limits per authenticated subject. Not shared across workers.
AUTH_DISCOVERY_LIMIT=10
AUTH_DISCOVERY_WINDOW_SECONDS=60
AUTH_DISCOVERY_CONCURRENCY=2
AUTH_ANALYSIS_LIMIT=6
AUTH_ANALYSIS_WINDOW_SECONDS=60
AUTH_ANALYSIS_CONCURRENCY=1
AUTH_SIMILARITY_LIMIT=20
AUTH_SIMILARITY_WINDOW_SECONDS=60
AUTH_SIMILARITY_CONCURRENCY=2
