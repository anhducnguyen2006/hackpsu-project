GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BACKEND_CORS_ORIGINS=http://localhost:5173
# External scientific repository discovery sources.
DATAVERSE_ENABLED=true
DATAVERSE_API_URL=https://dataverse.harvard.edu/api/search
DATAVERSE_RESULTS_LIMIT=5
ZENODO_ENABLED=true
ZENODO_API_URL=https://zenodo.org/api/records/
ZENODO_RESULTS_LIMIT=5
# Safe source-file analysis limits.
ANALYSIS_MAX_DOWNLOAD_BYTES=26214400
ANALYSIS_MAX_METADATA_BYTES=2097152
ANALYSIS_MAX_ROWS=100000
ANALYSIS_MAX_COLUMNS=500
ANALYSIS_MAX_REDIRECTS=3
ANALYSIS_DOWNLOAD_CONCURRENCY=2
DISCOVERY_SOURCE_CONCURRENCY=3
DISCOVERY_CANDIDATE_LIMIT=12
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=1
EMBEDDING_TOP_K=12
# Set true only for the cached, clearly labeled hackathon demo workflow.
DEMO_MODE=false
